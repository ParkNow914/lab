[19.31883, "o", "ok\r\r\n7> \r\r\n\u001b[38;5;42m### A soma rodou no codigo velho e a migracao no novo, na mesma volta.\u001b[0m\r\r\n\r\r\n"]
[22.147043, "o", "contador:ler()\b\b\u001b[C\u001b[C."]
[22.147892, "o", "\r\r\n"]
