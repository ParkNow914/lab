[7.591684, "o", "contador:somar(5)\b\b\b\u001b[C\u001b[C\u001b[C, contador:somar(7)\b\b\b\u001b[C\u001b[C\u001b[C, contador:ler()\b\b\u001b[C\u001b[C.\r\r\n\u001b[A\u001b[J3> contador:somar(5), contador:somar(7), contador:ler().\r\r\n12\r\r\n4> \r\r\n\u001b[38;5;42m### 12 na conta. Agora a versao 2, com esse processo ainda vivo.\u001b[0m\r\r\n\r\r\n"]
[12.109387, "o", "io:format(\"~ts\",[os:cmd(\"diff -u contador_v?.erl|tail -n+3\")\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C]\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C)\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C."]
[12.109789, "o", "\r\r\n\u001b[A\u001b[J4> io:format(\"~ts\",[os:cmd(\"diff -u contador_v?.erl|tail -n+3\")]).\r\r\n"]
[12.115474, "o", "@@ -1,9 +1,13 @@\r\r\n-%% Versao 1 -- a que vai estar rodando quando a troca acontecer.\r\r\n+%% Versao 2 -- carregada com o processo da versao 1 ainda vivo e com estado.\r\r\n+%%\r\r\n+%% Mudam duas coisas: passa a recusar numero negativo, e passa a contar\r\r\n+%% quantas operacoes aceitou. A segunda muda o FORMATO do estado, que e o\r\r\n+%% caso dificil de verdade.\r\r\n -module(contador).\r\r\n -export([iniciar/0, somar/1, ler/0, loop/1]).\r\r\n \r\r\n iniciar() ->\r\r\n-    Pid = spawn(fun() -> loop(0) end),\r\r\n+    Pid = spawn(fun() -> loop({0, 0}) end),\r\r\n     register(contador, Pid),\r\r\n     Pid.\r\r\n \r\r\n@@ -13,22 +17,30 @@\r\r\n \r\r\n ler() ->\r\r\n     contador ! {ler, self()},\r\r\n-    receive {valor, V} -> V\r\r\n+    receive {valor, V, Ops} -> {V, Ops}\r\r\n     after 1000 -> tempo_esgotado\r\r\n     end.\r\r\n \r\r\n-%% A chamada QUALIFICADA (?MODULE:loop) e o detalhe inteiro deste projeto.\r\r\n+%% Esta clausula e a migracao de estado, e ela existe porque o processo la\r\r\n+%% fora esta rodando AGORA com um inteiro na mao. Ele vai entrar aqui na\r\r\n+%% proxima mensagem que receber, e precisa ser recebido como estava -- nao\r\r\n+%% como o codigo novo gostaria que ele estivesse.\r\r\n %%\r\r\n-%% Um `loop(...)` simples seria uma chamada local: o processo continuaria\r\r\n-%% executando a versao do codigo com que nasceu, para sempre, por mais vezes\r\r\n-%% que o modulo fosse recompilado. Escrever o nome do modulo na frente manda a\r\r\n-%% maquina virtual procurar a versao ATUAL a cada volta -- e e nessa fresta que\r\r\n-%% a troca a quente entra.\r\r\n-loop(Total) ->\r\r\n+%% Sem ela, a troca daria function_clause e o processo morreria: o estado\r\r\n+%% antigo nao casa com nenhuma clausula nova. Isto e o que `code_change/3` faz\r\r\n+%% num gen_server, escrito a mao para ficar visivel.\r\r\n+loop(Total) when is_integer(Total) ->\r\r\n+    io:format(\"    [migrou o estado: ~p vira {~p,0}]~n\", [Total, Total]),\r\r\n+    ?MODULE:loop({Total, 0});\r\r\n+\r\r\n+loop({Total, Ops}) ->\r\r\n     receive\r\r\n+        {somar, N} when N < 0 ->\r\r\n+            io:format(\"    [recusou ~p: a versao 2 nao aceita negativo]~n\", [N]),\r\r\n+            ?MODULE:loop({Total, Ops});\r\r\n         {somar, N} ->\r\r\n-            ?MODULE:loop(Total + N);\r\r\n+            ?MODULE:loop({Total + N, Ops + 1});\r\r\n         {ler, De} ->\r\r\n-            De ! {valor, Total},\r\r\n-            ?MODULE:loop(Total)\r\r\n+            De ! {valor, Total, Ops},\r\r\n+            ?MODULE:loop({Total, Ops})\r\r\n     end.\r\r\nok\r\r\n"]
[12.115548, "o", "5> "]
[12.115758, "o", "\r\r\n\u001b[38;5;42m### Recusa negativo e conta operacoes: o FORMATO do estado mudou.\u001b[0m\r\r\n\r\r\n"]
[16.356715, "o", "os:cmd(\"cp contador_v2.erl contador.erl\")\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C, c(contador)\b\b\b\b\b\b\b\b\b\b\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C."]
[16.357416, "o", "\r\r\n\u001b[A\u001b[J5> os:cmd(\"cp contador_v2.erl contador.erl\"), c(contador).\r\r\n"]
[16.372312, "o", "{ok,contador}\r\r\n"]
[16.372591, "o", "6> \r\r\n\u001b[38;5;42m### Recompilado com o processo no ar. Nada foi reiniciado.\u001b[0m\r\r\n\r\r\n"]
